.PHONY : localutil.c.i

localutil.s: localutil.c.s
.PHONY : localutil.s

# target to generate assembly for a file
localutil.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/application.dir/build.make CMakeFiles/application.dir/localutil.c.s
.PHONY : localutil.c.s

